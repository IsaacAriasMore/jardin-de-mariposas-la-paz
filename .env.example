# Copie este archivo a .env para sobrescribir los valores por defecto.
# .env está excluido de Git (ver .gitignore). Configuración opcional: la app
# funciona sin él usando los valores por defecto definidos en src/config/.

# Entorno: development (local) | production (servidor real, p. ej. Hostinger).
NODE_ENV=development

# Puerto de escucha HTTP (por defecto 3000).
PORT=3000

# URL pública de producción. El dominio definitivo aún no está comprado;
# provisionalmente se usa jardindemariposaslapaz.com.
SITE_URL=https://jardindemariposaslapaz.com

# Enlace de Google Maps, desacoplado para reemplazarlo por el enlace oficial
# cuando exista. Por defecto apunta al Plus Code provisional del negocio.
GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=5F36%2BVVC%20Bajo%20La%20Paz%2C%20San%20Ram%C3%B3n%2C%20Alajuela%2020201%2C%20Costa%20Rica