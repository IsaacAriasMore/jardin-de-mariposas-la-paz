    "release:check": "node scripts/release-check.mjs",
    "release:build": "node scripts/build-release.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "license": "UNLICENSED",
  "dependencies": {
