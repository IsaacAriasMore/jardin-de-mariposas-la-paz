    "i18next": "^26.3.6",
    "i18next-fs-backend": "^2.6.7"
  },
  "devDependencies": {
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "supertest": "^7.2.2"
