<header class="site-header">
  <nav class="site-nav container" aria-label="Navegación principal">
    <a class="site-nav__brand" href="/"><%= site.name %></a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-list"
      aria-label="Abrir menú de navegación"
    >
      <svg class="nav-toggle__icon" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
        <g class="nav-toggle__line nav-toggle__line--top"><line x1="2" y1="3.5" x2="12" y2="3.5" /></g>
        <g class="nav-toggle__line nav-toggle__line--middle"><line x1="2" y1="7" x2="12" y2="7" /></g>
        <g class="nav-toggle__line nav-toggle__line--bottom"><line x1="2" y1="10.5" x2="12" y2="10.5" /></g>
      </svg>
    </button>
    <ul class="site-nav__list" id="nav-list" role="list">
      <% site.navigation.forEach(function (item) { %>
        <li>
          <a
            class="site-nav__link<%= currentPath === item.href ? ' is-active' : '' %>"
            href="<%= item.href %>"
            aria-current="<%= currentPath === item.href ? 'page' : undefined %>"
          ><%= item.label %></a>
        </li>
      <% }) %>
      <li class="site-nav__cta">
        <a class="btn btn--primary site-nav__cta-link" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"
          >Consultar visita</a
        >
      </li>
    </ul>
  </nav>
</header>
