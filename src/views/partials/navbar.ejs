<header class="site-header">
  <nav class="site-nav container" aria-label="Navegación principal">
    <a class="site-nav__brand" href="/"><%= site.shortName %></a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-list"
      aria-label="Abrir menú de navegación"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
    <ul class="site-nav__list" id="nav-list" role="list">
      <% site.navigation.forEach(function (item) { %>
        <li>
          <a
            class="site-nav__link<%= currentPath === item.href ? ' is-active' : '' %>"
            href="<%= item.href %>"
            aria-current="<%= currentPath === item.href ? 'page' : undefined %>"
          ><%= item.label %></a>
        </li>
      <% }) %>
      <li class="site-nav__cta">
        <a class="btn btn--primary site-nav__cta-link" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"
          >Consultar visita</a
        >
      </li>
    </ul>
  </nav>
</header>
