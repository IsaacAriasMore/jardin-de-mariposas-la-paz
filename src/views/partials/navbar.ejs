<header class="site-header">
  <nav class="site-nav container" aria-label="<%= t('nav.aria') %>">
    <a class="site-nav__brand" href="<%= paths.home %>"><%= site.name %></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list" aria-label="<%= t('nav.open') %>" data-label-open="<%= t('nav.open') %>" data-label-close="<%= t('nav.close') %>">
      <svg class="nav-toggle__icon" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><g class="nav-toggle__line nav-toggle__line--top"><line x1="2" y1="3.5" x2="12" y2="3.5" /></g><g class="nav-toggle__line nav-toggle__line--middle"><line x1="2" y1="7" x2="12" y2="7" /></g><g class="nav-toggle__line nav-toggle__line--bottom"><line x1="2" y1="10.5" x2="12" y2="10.5" /></g></svg>
    </button>
    <ul class="site-nav__list" id="nav-list" role="list">
      <% navigation.forEach(function (item) { %>
        <li><a class="site-nav__link<%= pageKey === item.page ? ' is-active' : '' %>" href="<%= item.href %>"<% if (pageKey === item.page) { %> aria-current="page"<% } %>><%= item.label %></a></li>
      <% }) %>
      <li class="site-nav__preferences">
        <div class="language-switch" aria-label="<%= t('language.label') %>">
          <% ['es', 'en'].forEach(function (language) { %>
            <a href="<%= alternatePaths ? alternatePaths[language] : (language === 'en' ? '/en' : '/') %>"<% if (locale === language) { %> aria-current="true"<% } %>><%= t(`language.${language}`) %></a>
          <% }) %>
        </div>
        <button class="theme-toggle" type="button" data-theme-toggle data-label-light="<%= t('theme.toLight') %>" data-label-dark="<%= t('theme.toDark') %>" aria-label="<%= t('theme.toDark') %>" title="<%= t('theme.toDark') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path data-theme-icon d="M12 4.5a7.5 7.5 0 1 0 7.5 7.5A6 6 0 0 1 12 4.5Z" /></svg>
        </button>
        <button class="motion-toggle" type="button" data-motion-toggle data-label-pause="<%= t('motion.pause') %>" data-label-activate="<%= t('motion.activate') %>" aria-label="<%= t('motion.pause') %>" aria-pressed="true" title="<%= t('motion.pause') %>">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path data-motion-icon d="M7 5v14M17 5v14" /></svg>
        </button>
      </li>
      <li class="site-nav__cta"><a class="btn btn--primary site-nav__cta-link" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultVisit') %></a></li>
    </ul>
  </nav>
</header>
