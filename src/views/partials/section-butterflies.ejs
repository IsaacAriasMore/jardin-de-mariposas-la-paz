    ['sm', 'mid', 'amber', 'b', 'desktop'],
    ['md', 'near', 'ochre', 'c', 'desktop'],
    ['xs', 'far', 'forest', 'd', 'mobile'],
    ['sm', 'mid', 'amber', 'e', 'desktop'],
    ['lg', 'near', 'cream', 'f', 'desktop'],
