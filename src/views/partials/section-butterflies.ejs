    'butterflies-opening': [4, 1], 'butterflies-band': [5, 3], 'butterflies-gallery': [5, 5], 'butterflies-outro': [4, 0],
    'gallery-main': [8, 0], 'gallery-cta': [7, 0],
    'environment-main': [8, 2], 'environment-why': [7, 3],
    'visit-location': [5, 0], 'visit-practical': [5, 3], 'visit-cta': [5, 5],
