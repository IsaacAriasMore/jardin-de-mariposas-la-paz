      <g class="section-butterfly__flight">
        <path class="section-butterfly__wing section-butterfly__wing--left" d="M16 12C9 2 2 3 3 9c.5 4 5 5 13 3Z" fill="currentColor" />
        <path class="section-butterfly__wing section-butterfly__wing--right" d="M16 12c7-10 14-9 13-3-.5 4-5 5-13 3Z" fill="currentColor" />
        <path d="M16 12c-4 8-9 7-9 2 .4-3 4-3 9-2Zm0 0c4 8 9 7 9 2-.4-3-4-3-9-2Z" fill="currentColor" />
