<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <section>
        <h2 class="site-footer__title"><%= site.name %></h2>
        <p class="site-footer__text"><%= site.location.address %></p>
        <p class="site-footer__maps-wrapper">
          <a class="site-footer__link" href="<%= config.googleMapsUrl %>" target="_blank" rel="noopener"
            >Cómo llegar en Google Maps</a
          >
        </p>
      </section>

      <section>
        <h2 class="site-footer__title">Horario</h2>
        <ul class="site-footer__list">
          <% site.hours.forEach(function (slot) { %>
            <li class="site-footer__text"><strong><%= slot.days %>:</strong> <%= slot.time %></li>
          <% }) %>
        </ul>
        <p class="site-footer__note">Entrada: <%= site.priceNote %>.</p>
      </section>

      <section>
        <h2 class="site-footer__title">Explorar</h2>
        <ul class="site-footer__list">
          <li>
            <a class="site-footer__link" href="/experiencia">Tour guiado</a>
          </li>
          <li>
            <a class="site-footer__link" href="/nuestro-mariposario">Nuestro Mariposario</a>
          </li>
          <li>
            <a class="site-footer__link" href="/galeria">Galería</a>
          </li>
          <li>
            <a class="site-footer__link" href="/visitanos">Visítanos</a>
          </li>
          <li>
            <a class="site-footer__link site-footer__link--secondary" href="/conservacion">Mariposas y su entorno</a>
          </li>
        </ul>
      </section>

      <section>
        <h2 class="site-footer__title">Contacto</h2>
        <ul class="site-footer__list">
          <li>
            <a class="site-footer__link site-footer__whatsapp btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"
              >WhatsApp</a
            >
          </li>
          <li>
            <a class="site-footer__link" href="<%= whatsapp.secondaryHref %>"><%= site.phones.secondary %></a>
          </li>
          <li>
            <a class="site-footer__link" href="<%= site.facebookUrl %>" target="_blank" rel="noopener"
              >Facebook · @mariposaslapaz</a
            >
          </li>
        </ul>
      </section>
    </div>
    <p class="site-footer__copy">
      &copy; <%= new Date().getFullYear() %> <%= site.name %> &middot; <%= site.location.address %>
    </p>
  </div>
</footer>
