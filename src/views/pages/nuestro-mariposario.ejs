<% const c = content; %>
<section class="page-header"><div class="container"><p class="page-header__label"><%= c.header.eyebrow %></p><h1 class="page-header__title"><%= c.header.title %></h1><p class="page-header__lead"><%= c.header.lead %></p></div></section>
<section class="page-section reveal" data-motion-group="mariposario-principal"><%- include('../partials/section-butterflies', { butterflies: ['garden-intro'] }) %><div class="container"><div class="nuestro-layout"><div class="nuestro-layout__image" data-motion-item="media-start"><img src="/media/img/mariposario-bajo-la-paz-01-1280.jpg" alt="<%= c.intro.alt %>" width="1280" height="1707" loading="lazy" /></div><div class="nuestro-layout__text" data-motion-item="copy-end"><div class="prose"><p><%= c.intro.body1 %></p><p><%= c.intro.body2 %></p></div></div></div></div></section>
<section class="page-section page-section--dark acompanada reveal" data-motion-group="visita-acompanada"><%- include('../partials/section-butterflies', { butterflies: ['garden-guided'] }) %><div class="container"><div class="acompanada__layout"><figure class="acompanada__media" data-motion-item="media-start"><img src="/media/img/guia-acompanando-visitante-960.jpg" alt="<%= c.guided.alt %>" width="960" height="640" loading="lazy" /></figure><div class="acompanada__text" data-motion-item="copy-end"><p class="eyebrow eyebrow--on-dark"><%= c.guided.eyebrow %></p><h2><%= c.guided.title %></h2><div class="prose"><p><%= c.guided.body1 %></p><p><%= c.guided.body2 %></p></div><p class="section-actions"><a class="btn" href="<%= paths.experience %>"><%= t('actions.tour') %></a></p></div></div></div></section>
<section class="page-section page-section--muted reveal" data-motion-group="entorno-galeria"><%- include('../partials/section-butterflies', { butterflies: ['garden-environment'] }) %><div class="container"><div class="mariposas-editorial__header" data-motion-item="copy"><h2 class="mariposas-editorial__title"><%= c.environment.title %></h2><p class="mariposas-editorial__subtitle"><%= c.environment.subtitle %></p></div><div class="entorno-mosaic" data-motion-item="gallery-stagger"><% const images=[['grupo-mariposas-naranjas-en-planta-1280.jpg',1280,1920],['mariposas-naranjas-fondo-natural-1280.jpg',1280,1920],['mariposario-bajo-la-paz-02-1280.jpg',1280,960]]; images.forEach(function(image,index){ const base=image[0].replace(/-\d+\.jpg$/, ''); %><article class="mariposas-editorial__item entorno-mosaic__item"><img src="/media/img/<%= image[0] %>" srcset="/media/img/<%= base %>-640.jpg 640w, /media/img/<%= image[0] %> <%= image[1] %>w" sizes="(max-width: 768px) 100vw, 50vw" alt="<%= c.environment.alts[index] %>" width="<%= image[1] %>" height="<%= image[2] %>" loading="lazy" decoding="async" /></article><% }) %></div></div></section>
