<!-- Nuestro Mariposario: editorial documentary, asymmetric split -->
<section class="page-header">
  <div class="container">
    <p class="page-header__label">El mariposario</p>
    <h1 class="page-header__title">Nuestro Mariposario</h1>
    <p class="page-header__lead">
      Conozca el espacio donde habitan las mariposas, rodeadas de
      la vegetación y las flores que las sostienen.
    </p>
  </div>
</section>

<section class="page-section">
  <div class="container">
    <div class="nuestro-layout reveal">
      <div class="nuestro-layout__image reveal-image">
        <img
          src="/media/img/mariposario-bajo-la-paz-01-1280.jpg"
          srcset="/media/img/mariposario-bajo-la-paz-01-640.webp 640w, /media/img/mariposario-bajo-la-paz-01-1280.webp 1280w"
          sizes="(max-width: 768px) 100vw, 55vw"
          alt="El Jardín de Mariposas La Paz, Bajo La Paz, San Ramón"
          width="1280"
          height="1707"
          loading="lazy"
        />
      </div>
      <div class="nuestro-layout__text">
        <div class="prose">
          <p>
            El Jardín de Mariposas La Paz se encuentra en Bajo La Paz, San Ramón,
            Alajuela, en el corazón del bosque nuboso del Valle Central de Costa Rica.
          </p>
          <p>
            Un espacio rural dedicado a la observación de mariposas entre flores tropicales
            y plantas locales: un jardín real donde la naturaleza se disfruta en su estado más auténtico.
          </p>
          <p>
            El entorno de bosque nuboso ofrece un ambiente propicio para las mariposas,
            rodeadas de biodiversidad, paisaje rural y la tranquilidad que caracteriza a San Ramón.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ======== ACOMPAÑADA: puente hacia la experiencia guiada -------------
     Foto real del guía acompañando a un visitante (aprobada para uso web). -->
<section class="page-section page-section--dark acompanada reveal">
  <div class="container">
    <div class="acompanada__layout">
      <figure class="acompanada__media reveal-image">
        <img
          src="/media/img/guia-acompanando-visitante-960.jpg"
          srcset="/media/img/guia-acompanando-visitante-640.webp 640w, /media/img/guia-acompanando-visitante-960.webp 960w"
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="Guía conversando con un visitante en el mariposario"
          width="960"
          height="640"
          loading="lazy"
        />
        <figcaption>Guía conversando con un visitante en el mariposario</figcaption>
      </figure>
      <div class="acompanada__text">
        <p class="eyebrow eyebrow--on-dark">Una experiencia acompañada</p>
        <h2>Recorrer el mariposario con un guía</h2>
        <div class="prose">
          <p>
            Más allá de recorrer el espacio, el mariposario ofrece visitas guiadas
            para grupos educativos y visitantes de distintas edades, con
            acompañamiento en español e inglés.
          </p>
          <p>
            <%= site.guidedVisits.guideExperience %>.
          </p>
        </div>
        <p class="section-actions">
          <a class="btn" href="/experiencia">Conocer la experiencia</a>
        </p>
      </div>
    </div>
  </div>
</section>

<section class="page-section page-section--muted">
  <div class="container">
    <div class="mariposas-editorial__header">
      <h2 class="mariposas-editorial__title">El entorno</h2>
      <p class="mariposas-editorial__subtitle">
        Bosque nuboso, biodiversidad y paisaje rural de Costa Rica.
      </p>
    </div>
    <div class="mariposas-editorial__grid mariposas-editorial__grid--duo reveal-stagger">
      <article class="mariposas-editorial__item">
        <img src="/media/img/grupo-mariposas-naranjas-en-planta-1280.jpg" srcset="/media/img/grupo-mariposas-naranjas-en-planta-640.webp 640w, /media/img/grupo-mariposas-naranjas-en-planta-1280.webp 1280w" sizes="50vw" alt="Mariposas sobre una planta tropical" loading="lazy" />
      </article>
      <article class="mariposas-editorial__item">
        <img src="/media/img/mariposas-naranjas-fondo-natural-1280.jpg" srcset="/media/img/mariposas-naranjas-fondo-natural-640.webp 640w, /media/img/mariposas-naranjas-fondo-natural-1280.webp 1280w" sizes="50vw" alt="Mariposas sobre fondo natural del bosque" loading="lazy" />
      </article>
      <article class="mariposas-editorial__item mariposas-editorial__item--wide">
        <img src="/media/img/mariposario-bajo-la-paz-02-1280.jpg" srcset="/media/img/mariposario-bajo-la-paz-02-640.webp 640w, /media/img/mariposario-bajo-la-paz-02-1280.webp 1280w, /media/img/mariposario-bajo-la-paz-02-1920.webp 1920w" sizes="100vw" alt="El Jardín de Mariposas La Paz, Bajo La Paz, San Ramón" loading="lazy" />
      </article>
    </div>
  </div>
</section>
