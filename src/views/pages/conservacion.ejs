<% const c = content; %>
<section class="page-header"><div class="container"><p class="page-header__label"><%= c.header.eyebrow %></p><h1 class="page-header__title"><%= c.header.title %></h1><p class="page-header__lead"><%= c.header.lead %></p></div></section>
<section class="conservacion-contemplative reveal" data-motion-group="entorno-principal"><%- include('../partials/section-butterflies', { butterflies: ['environment-main'] }) %><div class="container"><figure class="conservacion-contemplative__hero-image" data-motion-item="media"><img src="/media/img/mariposario-bajo-la-paz-02-1920.jpg" alt="<%= c.main.alt %>" width="1920" height="1440" loading="lazy" /></figure><div class="conservacion-contemplative__columns"><div data-motion-item="copy"><p class="eyebrow"><%= c.main.eyebrow %></p><h2><%= c.main.title %></h2><div class="prose"><p><%= c.main.body %></p></div></div><figure data-motion-item="image"><img src="/media/img/mariposa-sobre-flor-amarilla-1280.jpg" alt="<%= c.main.illustrationAlt %>" width="1280" height="960" loading="lazy" /></figure></div></div></section>
<section class="page-section page-section--dark reveal" data-motion-group="ecosistema"><%- include('../partials/section-butterflies', { butterflies: ['environment-why'] }) %><div class="container--narrow" data-motion-item="copy"><p class="eyebrow eyebrow--on-dark"><%= c.why.eyebrow %></p><h2><%= c.why.title %></h2><div class="prose"><p><%= c.why.body %></p></div></div></section>
<section class="page-section reveal" data-motion-group="aprender-cta"><div class="container--narrow" data-motion-item="copy"><p class="eyebrow"><%= c.cta.eyebrow %></p><h2><%= c.cta.title %></h2><div class="prose"><p><%= c.cta.body %></p></div><p class="section-actions"><a class="btn" href="<%= paths.experience %>"><%= t('actions.tour') %></a><a class="btn btn--ghost" href="<%= paths.visit %>"><%= t('nav.visit') %></a></p></div></section>
