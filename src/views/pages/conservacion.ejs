     ni campañas de conservación. -->

<section class="page-header">
  <div class="container">
    <p class="page-header__label">Naturaleza</p>
    <h1 class="page-header__title">Mariposas y su entorno</h1>
    <p class="page-header__lead">
      Las mariposas dependen de las plantas y de las condiciones de su entorno
      para completar su ciclo de vida. Conoce por qué esa relación es
      importante para la biodiversidad.
    </p>
  </div>
</section>

