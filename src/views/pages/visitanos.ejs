<% const c = content; %>
<section class="page-header"><div class="container"><p class="page-header__label"><%= c.header.eyebrow %></p><h1 class="page-header__title"><%= c.header.title %></h1><p class="page-header__lead"><%= c.header.lead %></p></div></section>
<section class="visitanos-location reveal" data-motion-group="ubicacion"><%- include('../partials/section-butterflies', { butterflies: ['visit-location'] }) %><div class="container"><div class="visitanos-location__layout"><figure class="visitanos-location__media" data-motion-item="media-start"><img src="/media/img/mariposario-bajo-la-paz-01-1280.jpg" alt="<%= c.location.alt %>" width="1280" height="1707" loading="lazy" /></figure><div class="visitanos-location__copy" data-motion-item="copy-end"><p class="eyebrow"><%= c.location.eyebrow %></p><h2><%= c.location.title %></h2><address class="visitanos-address"><%= site.location.address %></address><p class="visitanos-location__note"><%= c.location.body %></p></div></div><figure class="visitanos-map"><div class="visitanos-map__frame" data-motion-item="media"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25241.773810165894!2d-84.54318295!3d10.1475119!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa04162ced6b1a7%3A0xb9fc4e6fc01e58d6!2sJardin%20De%20Mariposas%20La%20Paz!5e1!3m2!1ses!2scr!4v1786590182533!5m2!1ses!2scr" title="<%= c.location.iframeTitle %>" width="600" height="450" loading="lazy" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div><figcaption class="visitanos-map__meta"><span><strong>Bajo La Paz, San Ramón</strong><span><%= site.location.address %></span></span><span><%= site.location.reference %></span></figcaption><div class="visitanos-map__actions" data-motion-item="actions"><a class="btn btn--primary" href="<%= config.googleMapsDirectionsUrl %>" target="_blank" rel="noopener"><%= t('actions.directions') %></a><a class="btn btn--ghost" href="<%= config.googleMapsUrl %>" target="_blank" rel="noopener"><%= t('actions.openMaps') %></a></div></figure></div></section>
<section class="visitanos-practico reveal" data-motion-group="informacion-practica"><%- include('../partials/section-butterflies', { butterflies: ['visit-practical'] }) %><div class="container"><div class="visitanos-practico__layout" data-motion-item="stagger"><div><p class="eyebrow"><%= c.practical.hoursEyebrow %></p><h2><%= c.practical.hoursTitle %></h2><dl class="visitanos-hours"><% localizedHours.forEach(function(slot){ %><div class="visitanos-hours__row"><dt><%= slot.days %></dt><dd><%= slot.time %></dd></div><% }) %></dl><p class="visitanos-price"><%= t('footer.admission', { value: t('business.priceNote') }) %></p></div><div><p class="eyebrow"><%= c.practical.directionsEyebrow %></p><h2><%= c.practical.directionsTitle %></h2><p class="visitanos-reference"><%= site.location.reference %></p><p class="visitanos-plus-code"><%= site.location.plusCode %></p></div><div><p class="eyebrow"><%= c.practical.tourEyebrow %></p><h2><%= c.practical.tourTitle %></h2><p class="visitanos-reference"><%= c.practical.tourBody %></p><p class="section-actions"><a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultWhatsApp') %></a></p></div></div></div></section>
<section class="visitanos-cta reveal" data-motion-group="contacto-cta"><%- include('../partials/section-butterflies', { butterflies: ['visit-cta'] }) %><div class="container"><div class="visitanos-cta__layout"><div data-motion-item="copy"><p class="eyebrow eyebrow--on-dark"><%= c.cta.eyebrow %></p><h2><%= c.cta.title %></h2><div class="prose"><p><%= c.cta.body %></p></div><ul class="visitanos-contact-list"><li><a href="<%= whatsapp.primaryHref %>"><%= t('pages:visit.cta.call', { phone: site.phones.primary }) %></a></li><li><a href="<%= whatsapp.secondaryHref %>"><%= t('pages:visit.cta.call', { phone: site.phones.secondary }) %></a></li><li><a href="<%= site.facebookUrl %>" target="_blank" rel="noopener"><%= c.cta.facebook %></a></li></ul></div><div class="visitanos-cta__actions" data-motion-item="actions"><a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultWhatsApp') %></a><a class="btn btn--ghost-dark" href="<%= config.googleMapsUrl %>" target="_blank" rel="noopener"><%= c.cta.map %></a></div></div></div></section>
<script type="application/ld+json" nonce="<%= cspNonce %>"><%- schema %></script>
