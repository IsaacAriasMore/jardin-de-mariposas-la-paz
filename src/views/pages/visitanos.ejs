<!-- Visítanos: conversión local. Directa y escaneable: fotografía REAL del
     lugar, información práctica en columnas y contacto/CTA en oscuro.
     Datos 100% desde business.js; structured data LocalBusiness (schema)
     generada desde la misma fuente. No se inventan precios, parqueo,
     accesibilidad, servicios ni políticas. -->

<section class="page-header">
  <div class="container">
    <p class="page-header__label">Bajo La Paz · San Ramón</p>
    <h1 class="page-header__title">Visítanos</h1>
    <p class="page-header__lead">
      Encuentra horarios, ubicación y la información que necesitas para planear
      tu visita al mariposario.
    </p>
  </div>
</section>

<!-- ======== UBICACIÓN: fotografía real + dirección ---------------------- -->
<section class="visitanos-location reveal" data-motion-group="ubicacion">
  <div class="container">
    <div class="visitanos-location__layout">
      <figure class="visitanos-location__media" data-motion-item="media-start">
        <img
          src="/media/img/mariposario-bajo-la-paz-01-1280.jpg"
          srcset="/media/img/mariposario-bajo-la-paz-01-640.webp 640w, /media/img/mariposario-bajo-la-paz-01-1280.webp 1280w"
          sizes="(max-width: 768px) 100vw, 46vw"
          alt="El Jardín de Mariposas La Paz en Bajo La Paz, San Ramón"
          width="1280"
          height="1707"
          loading="lazy"
        />
        <figcaption class="media-caption">El mariposario en Bajo La Paz, San Ramón</figcaption>
      </figure>
      <div class="visitanos-location__copy" data-motion-item="copy-end">
        <p class="eyebrow">Ubicación</p>
        <h2>Encuéntranos en Bajo La Paz</h2>
        <address class="visitanos-address">
          <%= site.location.address %>
        </address>
        <p class="visitanos-location__note">
          Nos encontramos en Bajo La Paz, San Ramón, rodeados por el entorno
          natural de esta zona de Alajuela.
        </p>
      </div>
    </div>

    <!-- Mapa oficial (iframe, sin API key): complemento visual de la
         ubicación junto a la fotografía, la dirección, la referencia y el
         Plus Code. El enlace "Ver en Google Maps" se mantiene como
         alternativa externa. Los datos del negocio NO se derivan de este
         embed: la fuente de verdad sigue siendo business.js. -->
    <figure class="visitanos-map">
      <div class="visitanos-map__frame" data-motion-item="media">
        <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25241.773810165894!2d-84.54318295!3d10.1475119!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa04162ced6b1a7%3A0xb9fc4e6fc01e58d6!2sJardin%20De%20Mariposas%20La%20Paz!5e1!3m2!1ses!2scr!4v1786590182533!5m2!1ses!2scr"
        title="Ubicación de Jardín de Mariposas La Paz en Google Maps"
        width="600"
        height="450"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <figcaption class="visitanos-map__meta">
        <span><strong>Bajo La Paz, San Ramón</strong><span><%= site.location.address %></span></span>
        <span><%= site.location.reference %></span>
      </figcaption>
      <div class="visitanos-map__actions" data-motion-item="actions">
        <a class="btn btn--primary" href="<%= config.googleMapsDirectionsUrl %>" target="_blank" rel="noopener">Cómo llegar</a>
        <a class="btn btn--ghost" href="<%= config.googleMapsUrl %>" target="_blank" rel="noopener">Abrir en Google Maps</a>
      </div>
    </figure>
  </div>
</section>

<!-- ======== INFORMACIÓN PRÁCTICA: horario + cómo llegar ----------------- -->
<section class="visitanos-practico reveal" data-motion-group="informacion-practica">
  <div class="container">
    <div class="visitanos-practico__layout" data-motion-item="stagger">
      <div>
        <p class="eyebrow">Horario</p>
        <h2>Cuándo venir</h2>
        <dl class="visitanos-hours">
          <% site.hours.forEach(function (slot) { %>
            <div class="visitanos-hours__row">
              <dt><%= slot.days %></dt>
              <dd><%= slot.time %></dd>
            </div>
          <% }) %>
        </dl>
        <p class="visitanos-price">
          Entrada: <a href="<%= whatsapp.primary %>" target="_blank" rel="noopener">consultar por WhatsApp</a>.
        </p>
      </div>
      <div>
        <p class="eyebrow">Cómo llegar</p>
        <h2>Referencia</h2>
        <p class="visitanos-reference"><%= site.location.reference %></p>
        <p class="visitanos-plus-code"><%= site.location.plusCode %></p>
      </div>
      <div>
        <p class="eyebrow">Tour guiado</p>
        <h2>¿Quieres realizar el tour?</h2>
        <p class="visitanos-reference">
          Disfruta de un recorrido guiado en español o inglés con un guía
          certificado por el ICT. Consulta disponibilidad, precio y duración
          por WhatsApp.
        </p>
        <p class="section-actions">
          <a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
            Consultar por WhatsApp
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======== CONTACTO + CTA: WhatsApp protagonista ----------------------- -->
<section class="visitanos-cta reveal" data-motion-group="contacto-cta">
  <div class="container">
    <div class="visitanos-cta__layout">
      <div data-motion-item="copy">
        <p class="eyebrow eyebrow--on-dark">Contacto</p>
        <h2>¿Quieres visitarnos?</h2>
        <div class="prose">
          <p>
            Para consultar el tour, precio, duración o cualquier duda antes de
            venir, escríbenos por WhatsApp.
          </p>
        </div>
        <ul class="visitanos-contact-list">
          <li>
            <a href="<%= whatsapp.primaryHref %>">Llamar al <%= site.phones.primary %></a>
          </li>
          <li>
            <a href="<%= whatsapp.secondaryHref %>">Llamar al <%= site.phones.secondary %></a>
          </li>
          <li>
            <a href="<%= site.facebookUrl %>" target="_blank" rel="noopener"
              >Seguir en Facebook · @mariposaslapaz</a
            >
          </li>
        </ul>
      </div>
      <div class="visitanos-cta__actions" data-motion-item="actions">
        <a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
          Consultar por WhatsApp
        </a>
        <a class="btn btn--ghost-dark" href="<%= config.googleMapsUrl %>" target="_blank" rel="noopener">
          Ver en Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Structured data LocalBusiness (datos confirmados de business.js) -->
<script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify(schema) %></script>
