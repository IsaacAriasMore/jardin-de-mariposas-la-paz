<% const c = content; const shortHours = localizedHours.map(function (slot, index) { return `${c.quick[['shortHours', 'saturday', 'sunday'][index]]} ${slot.time}`; }).join(' · '); %>
<section class="hero" aria-label="<%= c.hero.aria %>">
  <div class="hero__media"><video class="hero__video" autoplay muted loop playsinline preload="none" aria-hidden="true" data-source-desktop-webm="/media/videos/mariposa-flor-amarilla-hero-1080p.webm" data-source-desktop-mp4="/media/videos/mariposa-flor-amarilla-hero-1080p.mp4" data-source-mobile-webm="/media/videos/mariposas-entre-hojas-vertical-1080.webm" data-source-mobile-mp4="/media/videos/mariposas-entre-hojas-vertical-1080.mp4"></video></div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <p class="hero__location">Bajo La Paz · San Ramón · Costa Rica</p><h1 class="hero__title"><%= site.name %></h1><p class="hero__lead"><%= c.hero.lead %></p>
    <div class="hero__actions"><a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultVisit') %></a><a class="btn btn--large btn--ghost-dark" href="<%= paths.experience %>"><%= t('actions.tour') %></a></div>
    <button class="hero__motion-toggle" type="button" data-hero-motion-toggle data-mode="full" aria-pressed="true" aria-label="<%= t('motion.pause') %>" title="<%= t('motion.pause') %>" data-label-pause="<%= t('motion.pause') %>" data-label-activate="<%= t('motion.activate') %>" data-label-replay="<%= t('motion.replay') %>"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path class="hero__motion-icon-play" d="M5 3.5v9l7-4.5-7-4.5Z" /><path class="hero__motion-icon-pause" d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z" /></svg><span class="hero__motion-toggle-label"><%= t('motion.pause') %></span></button>
  </div><span class="hero__tagline" aria-hidden="true"><%= c.hero.tagline %></span>
</section>
<section class="quickfacts" aria-label="<%= c.quick.aria %>"><%- include('../partials/section-butterflies', { butterflies: ['home-upper'] }) %><div class="container"><ul class="quickfacts__list"><li class="quickfacts__item"><span class="quickfacts__label"><%= t('labels.location') %></span><span class="quickfacts__value"><%= site.location.address.split(', ').slice(0, 2).join(' · ') %></span></li><li class="quickfacts__item"><span class="quickfacts__label"><%= t('labels.hours') %></span><span class="quickfacts__value"><%= shortHours %></span></li><li class="quickfacts__item"><span class="quickfacts__label"><%= t('labels.admission') %></span><span class="quickfacts__value"><%= t('business.priceNote') %></span></li><li class="quickfacts__item"><span class="quickfacts__label"><%= t('labels.guidedVisits') %></span><span class="quickfacts__value"><%= t('business.languages') %></span></li></ul></div></section>
<section class="guia-experiencia reveal" data-motion-group="tour" aria-labelledby="guia-title"><%- include('../partials/section-butterflies', { butterflies: ['home-tour'] }) %><div class="container"><div class="guia-experiencia__layout"><div class="guia-experiencia__text" data-motion-item="copy"><p class="guia-experiencia__label"><%= c.tour.eyebrow %></p><h2 id="guia-title" class="guia-experiencia__title"><%= c.tour.title %></h2><div class="prose"><p><%= c.tour.body1 %></p><p><%= c.tour.body2 %></p></div><p class="guide-credential"><span class="guide-credential__title"><%= t('business.guideCredential') %></span><span class="guide-credential__sub"><%= t('business.serviceLanguages') %></span></p><p class="guia-experiencia__audiences"><%= c.tour.audience %></p><p class="section-actions"><a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultWhatsApp') %></a><a class="btn btn--ghost" href="<%= paths.experience %>"><%= t('actions.tour') %></a></p></div><figure class="guia-experiencia__media" data-motion-item="image" data-tilt><img src="/media/img/guia-mariposario-mariposa-960.jpg" srcset="/media/img/guia-mariposario-mariposa-640.webp 640w, /media/img/guia-mariposario-mariposa-960.webp 960w" sizes="(max-width: 768px) 100vw, 50vw" alt="<%= c.tour.imageAlt %>" width="960" height="640" loading="lazy" /></figure></div></div></section>
<section class="intro reveal" data-motion-group="mariposario" aria-labelledby="intro-title"><%- include('../partials/section-butterflies', { butterflies: ['home-garden'] }) %><div class="container"><div class="intro__layout"><div class="intro__text" data-motion-item="copy"><p class="intro__label"><%= c.garden.eyebrow %></p><h2 id="intro-title" class="intro__heading"><%= c.garden.title %></h2><p class="intro__body"><%= c.garden.body1 %></p><p class="intro__body"><%= c.garden.body2 %></p><p class="section-actions"><a class="btn btn--ghost" href="<%= paths.garden %>"><%= c.garden.action %></a></p></div><div class="intro__image" data-motion-item="image" data-tilt><img src="/media/img/mariposario-bajo-la-paz-01-1280.jpg" srcset="/media/img/mariposario-bajo-la-paz-01-640.webp 640w, /media/img/mariposario-bajo-la-paz-01-1280.webp 1280w" sizes="(max-width: 768px) 100vw, 50vw" alt="<%= c.garden.imageAlt %>" width="1280" height="1707" loading="lazy" /></div></div></div></section>
<section class="mariposas-editorial reveal" data-motion-group="mariposas" aria-labelledby="marip-title"><%- include('../partials/section-butterflies', { butterflies: ['home-butterflies'] }) %><div class="mariposas-editorial__header" data-motion-item="copy"><h2 id="marip-title" class="mariposas-editorial__title"><%= c.butterflies.title %></h2><p class="mariposas-editorial__subtitle"><%= c.butterflies.subtitle %></p></div><div class="mariposas-editorial__grid" data-motion-item="stagger"><% const butterflies = [['mariposa-negra-amarilla-flor-roja-1280.jpg','1280','1800'],['mariposa-azul-pequena-flor-violeta-1280.jpg','1280','877'],['mariposa-naranja-flores-528.jpg','528','960']]; butterflies.forEach(function (item, index) { %><article class="mariposas-editorial__item<%= index === 2 ? ' mariposas-editorial__item--compact' : '' %>"><img src="/media/img/<%= item[0] %>" alt="<%= c.butterflies.alts[index] %>" width="<%= item[1] %>" height="<%= item[2] %>" loading="lazy" /><div class="mariposas-editorial__item-overlay"><span class="mariposas-editorial__item-name"><%= c.butterflies.names[index] %></span></div></article><% }) %></div><div class="mariposas-editorial__cta"><a class="mariposas-editorial__more" href="<%= paths.butterflies %>"><%= c.butterflies.action %></a></div></section>
<section class="experiencia-full reveal" aria-labelledby="exp-title"><%- include('../partials/section-butterflies', { butterflies: ['home-visual'] }) %><div class="container"><div class="experiencia-full__layout"><div class="experiencia-full__text"><p class="experiencia-full__label"><%= c.observe.eyebrow %></p><h2 id="exp-title" class="experiencia-full__title"><%= c.observe.title %></h2><p class="experiencia-full__body"><%= c.observe.body %></p><a class="btn" href="<%= paths.experience %>"><%= t('actions.tour') %></a></div><figure class="experiencia-full__media reveal-image"><img src="/media/img/pexels-joerg-hartmann-626385254-38778510-1920.jpg" alt="<%= c.observe.caption %>" width="1920" height="1280" loading="lazy" /></figure></div></div></section>
<section class="conservacion-essay reveal" aria-labelledby="cons-title"><div class="container"><div class="conservacion-essay__layout"><div class="conservacion-essay__image reveal-image"><img src="/media/img/mariposa-sobre-flor-amarilla-1280.jpg" alt="<%= c.environment.title %>" width="1280" height="960" loading="lazy" /></div><div class="conservacion-essay__text"><h2 id="cons-title" class="conservacion-essay__title"><%= c.environment.title %></h2><div class="prose"><p><%= c.environment.body %></p></div><p class="section-actions"><a class="btn btn--ghost" href="<%= paths.environment %>"><%= t('actions.learnMore') %></a></p></div></div></div></section>
<section class="galeria-editorial reveal" data-motion-group="galeria" aria-labelledby="gal-title"><%- include('../partials/section-butterflies', { butterflies: ['home-gallery'] }) %><div class="galeria-editorial__header" data-motion-item="copy"><h2 id="gal-title" class="galeria-editorial__title"><%= c.gallery.title %></h2><p class="galeria-editorial__subtitle"><%= c.gallery.subtitle %></p></div><div class="galeria-masonry" data-motion-item="stagger"><% const galleryImages = [['mariposa-azul-hoja-tropical-1280.jpg',1280,720],['grupo-mariposas-naranjas-en-planta-1280.jpg',1280,1920],['mariposas-naranjas-en-vuelo-1280.jpg',1280,856],['mariposas-naranjas-fondo-natural-1280.jpg',1280,1920],['mariposa-oscura-puntos-azules-960.jpg',960,540],['mariposario-bajo-la-paz-02-1280.jpg',1280,960]]; galleryImages.forEach(function (image, index) { const base=image[0].replace(/-\d+\.jpg$/, ''); %><div class="galeria-masonry__item"><img src="/media/img/<%= image[0] %>" srcset="/media/img/<%= base %>-640.jpg 640w, /media/img/<%= image[0] %> <%= image[1] %>w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw" alt="<%= c.gallery.alts[index] %>" width="<%= image[1] %>" height="<%= image[2] %>" loading="lazy" decoding="async" /></div><% }) %></div><div class="galeria-editorial__cta"><a class="btn btn--ghost" href="<%= paths.gallery %>"><%= c.gallery.action %></a></div></section>
<section class="planifica reveal" aria-labelledby="plan-title"><%- include('../partials/section-butterflies', { butterflies: ['home-plan'] }) %><div class="container"><div class="planifica__layout"><div class="planifica__text"><p class="planifica__label"><%= c.plan.eyebrow %></p><h2 id="plan-title" class="planifica__title"><%= c.plan.title %></h2><dl class="ubicacion-details"><div><dt><%= t('labels.location') %></dt><dd><%= site.location.address.split(', ').slice(0,2).join(' · ') %></dd></div><div><dt><%= t('labels.hours') %></dt><dd><% localizedHours.forEach(function(slot, index) { %><%= slot.days %>: <%= slot.time %><%= index < localizedHours.length - 1 ? ' · ' : '' %><% }) %></dd></div><div><dt><%= t('labels.tour') %></dt><dd><%= c.plan.tourText %></dd></div></dl></div><div class="planifica__cta"><p class="planifica__cta-body"><%= c.plan.body %></p><p class="section-actions"><a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultWhatsApp') %></a><a class="btn btn--ghost" href="<%= paths.visit %>"><%= t('actions.directions') %></a></p></div></div></div></section>
<section class="cta-final reveal" data-motion-group="cta" aria-labelledby="cta-final-title"><%- include('../partials/section-butterflies', { butterflies: ['home-cta'] }) %><div class="container--narrow" data-motion-item="copy"><p class="eyebrow eyebrow--on-dark"><%= c.cta.eyebrow %></p><h2 id="cta-final-title" class="cta-final__title"><%= c.cta.title %></h2><p class="cta-final__body"><%= c.cta.body %></p><a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultWhatsApp') %></a></div></section>
