<!--
  THESIS: Un mariposario rural real donde la fotografía y el video son el
  producto. Publicación digital de naturaleza, no plantilla turística.
  FIRST VIEWPORT: Hero full-bleed con video, contenido alineado a la izquierda,
  tagline vertical sutil a la derecha. La fotografía manda.
  VIDEO: un solo video (hero), un elemento por breakpoint (horizontal desktop,
  vertical móvil), cada uno con su poster. El oculto vía display:none no
  descarga su fuente.
  HIERARCHY: HERO → INFORMACIÓN RÁPIDA → TOUR GUIADO (tour por el mariposario,
  guía certificado por el ICT, español/inglés, aprendizaje, públicos) → NUESTRO
  MARIPOSARIO (el lugar) → EL MUNDO DE LAS MARIPOSAS → EXPERIENCIA VISUAL
  (emocional) → CONSERVACIÓN (secundaria) → GALERÍA PREVIEW → PLANIFICA TU
  VISITA → CTA FINAL (WhatsApp).
  FINISH: unreviewed and undocumented is unfinished.
-->

<% var dayShort = { 'Lunes a viernes': 'Lun–vie', 'Sábado': 'Sáb', 'Domingo': 'Dom' }; %>
<% var compactHours = site.hours.map(function (s) { return (dayShort[s.days] || s.days) + ' ' + s.time; }).join(' · '); %>

<!-- ======== HERO ====================================================== -->
<section class="hero" aria-label="Presentación principal">
  <div class="hero__media">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-source-desktop-webm="/media/videos/mariposa-flor-amarilla-hero-1080p.webm"
      data-source-desktop-mp4="/media/videos/mariposa-flor-amarilla-hero-1080p.mp4"
      data-source-mobile-webm="/media/videos/mariposas-entre-hojas-vertical-1080.webm"
      data-source-mobile-mp4="/media/videos/mariposas-entre-hojas-vertical-1080.mp4"
    ></video>
  </div>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content">
    <p class="hero__location">Bajo La Paz · San Ramón · Costa Rica</p>
    <h1 class="hero__title"><%= site.name %></h1>
    <p class="hero__lead">
      Descubre de cerca el fascinante mundo de las mariposas. Vive una
      experiencia guiada entre mariposas y naturaleza.
    </p>
    <div class="hero__actions">
      <a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
        Consultar visita
      </a>
      <a class="btn btn--large btn--ghost-dark" href="/experiencia">Conocer el tour</a>
    </div>
    <button class="hero__motion-toggle" type="button" data-hero-motion-toggle data-mode="full" aria-pressed="true" aria-label="Pausar movimiento" title="Pausar movimiento">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path class="hero__motion-icon-play" d="M5 3.5v9l7-4.5-7-4.5Z" />
        <path class="hero__motion-icon-pause" d="M4.5 3h2.5v10H4.5zM9 3h2.5v10H9z" />
      </svg>
      <span class="hero__motion-toggle-label">Pausar movimiento</span>
    </button>
  </div>
  <span class="hero__tagline" aria-hidden="true">Donde la naturaleza cobra alas</span>
</section>

<!-- ======== INFORMACIÓN RÁPIDA: franja escaneable, sin cards ------------- -->
<section class="quickfacts" aria-label="Información rápida">
  <div class="container">
    <ul class="quickfacts__list">
      <li class="quickfacts__item">
        <span class="quickfacts__label">Ubicación</span>
        <span class="quickfacts__value"><%= site.location.address.split(', ').slice(0, 2).join(' · ') %></span>
      </li>
      <li class="quickfacts__item">
        <span class="quickfacts__label">Horario</span>
        <span class="quickfacts__value"><%= compactHours %></span>
      </li>
      <li class="quickfacts__item">
        <span class="quickfacts__label">Entrada</span>
        <span class="quickfacts__value"><%= site.priceNote %></span>
      </li>
      <li class="quickfacts__item">
        <span class="quickfacts__label">Visitas guiadas</span>
        <span class="quickfacts__value"><%= site.guidedVisits.languages.join(' · ') %></span>
      </li>
    </ul>
  </div>
</section>

<!-- ======== TOUR GUIADO: tour por el mariposario, aprendizaje y públicos -->
<!-- Propuesta de valor principal: experiencia guiada + aprendizaje + lugar
     real + contacto por WhatsApp. La fotografía del guía está aprobada para
     uso web; la credencial ICT proviene de business.js (sin inventar años). -->
<section class="guia-experiencia reveal" data-motion-group="tour" aria-labelledby="guia-title">
  <div class="container">
    <div class="guia-experiencia__layout">
      <div class="guia-experiencia__text" data-motion-item="copy">
        <p class="guia-experiencia__label">Experiencia guiada</p>
        <h2 id="guia-title" class="guia-experiencia__title">Tour por el Mariposario</h2>
        <div class="prose">
          <p>
            Durante el recorrido descubrirás cómo viven y se desarrollan las
            mariposas. Conocerás su ciclo de vida, desde el huevo y la oruga
            hasta la crisálida y la mariposa adulta, además de aspectos de su
            comportamiento, alimentación y reproducción.
          </p>
          <p>
            El guía también te explicará cómo las condiciones del entorno
            influyen en su desarrollo, algunas características que permiten
            conocerlas mejor y la importancia que tienen dentro del ecosistema.
          </p>
        </div>
        <p class="guide-credential">
          <span class="guide-credential__title"><%= site.guidedVisits.guideCredential %></span>
          <span class="guide-credential__sub">Atención en español e inglés</span>
        </p>
        <p class="guia-experiencia__audiences">
          Una experiencia para distintas edades, desde kínder y grupos escolares
          hasta familias, personas adultas y adultas mayores.
        </p>
        <p class="section-actions">
          <a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
            Consultar por WhatsApp
          </a>
          <a class="btn btn--ghost" href="/experiencia">Conocer el tour</a>
        </p>
      </div>
      <figure class="guia-experiencia__media" data-motion-item="image" data-tilt>
        <img
          src="/media/img/guia-mariposario-mariposa-960.jpg"
          srcset="/media/img/guia-mariposario-mariposa-640.webp 640w, /media/img/guia-mariposario-mariposa-960.webp 960w"
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="Guía mostrando una mariposa durante una visita"
          width="960"
          height="640"
          loading="lazy"
        />
        <figcaption>Guía mostrando una mariposa durante una visita</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ======== INTRO: editorial split, el lugar ---------------------------- -->
<section class="intro reveal" data-motion-group="mariposario" aria-labelledby="intro-title">
  <div class="container">
    <div class="intro__layout">
      <div class="intro__text" data-motion-item="copy">
        <p class="intro__label">Nuestro Mariposario</p>
        <h2 id="intro-title" class="intro__heading">Un espacio para las mariposas</h2>
        <p class="intro__body">
          Jardín de Mariposas La Paz se encuentra en Bajo La Paz, San Ramón,
          rodeado de vegetación y del entorno natural de esta zona de Costa
          Rica.
        </p>
        <p class="intro__body">
          Aquí podrás observar mariposas de cerca y descubrir más sobre su
          desarrollo mientras recorres el mariposario.
        </p>
        <p class="section-actions">
          <a class="btn btn--ghost" href="/nuestro-mariposario">Conocer el mariposario</a>
        </p>
      </div>
      <div class="intro__image" data-motion-item="image" data-tilt>
        <img
          src="/media/img/mariposario-bajo-la-paz-01-1280.jpg"
          srcset="/media/img/mariposario-bajo-la-paz-01-640.webp 640w, /media/img/mariposario-bajo-la-paz-01-1280.webp 1280w"
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="El Jardín de Mariposas La Paz en Bajo La Paz, San Ramón"
          width="1280"
          height="1707"
          loading="lazy"
        />
        <span class="intro__image-caption">El mariposario en Bajo La Paz, San Ramón</span>
      </div>
    </div>
  </div>
</section>

<!-- ======== MARIPOSAS: editorial grid, varied sizes -------------------- -->
<section class="mariposas-editorial reveal" data-motion-group="mariposas" aria-labelledby="marip-title">
  <div class="mariposas-editorial__header" data-motion-item="copy">
    <h2 id="marip-title" class="mariposas-editorial__title">El mundo de las mariposas</h2>
    <p class="mariposas-editorial__subtitle">
      Colores, formas y una transformación que podrás conocer durante tu visita.
    </p>
  </div>
  <div class="mariposas-editorial__grid" data-motion-item="stagger">
    <article class="mariposas-editorial__item">
      <img
        src="/media/img/mariposa-negra-amarilla-flor-roja-1280.jpg"
        srcset="/media/img/mariposa-negra-amarilla-flor-roja-640.webp 640w, /media/img/mariposa-negra-amarilla-flor-roja-1280.webp 1280w"
        sizes="(max-width: 768px) 100vw, 45vw"
        alt="Mariposa negra y amarilla posada sobre una flor roja"
        width="1280"
        height="1800"
        loading="lazy"
      />
      <div class="mariposas-editorial__item-overlay">
        <span class="mariposas-editorial__item-name">Mariposa sobre flor roja</span>
      </div>
    </article>
    <article class="mariposas-editorial__item">
      <img
        src="/media/img/mariposa-azul-pequena-flor-violeta-1280.jpg"
        srcset="/media/img/mariposa-azul-pequena-flor-violeta-640.webp 640w, /media/img/mariposa-azul-pequena-flor-violeta-1280.webp 1280w"
        sizes="(max-width: 768px) 50vw, 28vw"
        alt="Mariposa azul pequeña sobre flor violeta"
        width="1280"
        height="877"
        loading="lazy"
      />
      <div class="mariposas-editorial__item-overlay">
        <span class="mariposas-editorial__item-name">Mariposa azul pequeña</span>
      </div>
    </article>
    <article class="mariposas-editorial__item mariposas-editorial__item--compact">
      <img
        src="/media/img/mariposa-naranja-flores-528.jpg"
        srcset="/media/img/mariposa-naranja-flores-480.webp 480w, /media/img/mariposa-naranja-flores-528.webp 528w"
        sizes="(max-width: 768px) 480px, 28vw"
        alt="Mariposa naranja entre flores"
        width="528"
        height="960"
        loading="lazy"
      />
      <div class="mariposas-editorial__item-overlay">
        <span class="mariposas-editorial__item-name">Mariposa naranja entre flores</span>
      </div>
    </article>
  </div>
  <div class="mariposas-editorial__cta">
    <a class="mariposas-editorial__more" href="/mariposas">Explorar el mundo de las mariposas</a>
  </div>
</section>

<!-- ======== EXPERIENCIA VISUAL: oscuro, emocional ---------------------- -->
<section class="experiencia-full reveal" aria-labelledby="exp-title">
  <div class="container">
    <div class="experiencia-full__layout">
      <div class="experiencia-full__text">
        <p class="experiencia-full__label">Observar de cerca</p>
        <h2 id="exp-title" class="experiencia-full__title">
          Descubre detalles que normalmente pasan desapercibidos
        </h2>
        <p class="experiencia-full__body">
          Recorre el mariposario, observa las mariposas y aprovecha la visita
          guiada para aprender sobre su comportamiento y transformación.
        </p>
        <a class="btn" href="/experiencia">Conocer el tour</a>
      </div>
      <figure class="experiencia-full__media reveal-image">
        <img
          src="/media/img/pexels-joerg-hartmann-626385254-38778510-1920.jpg"
          srcset="/media/img/pexels-joerg-hartmann-626385254-38778510-640.webp 640w, /media/img/pexels-joerg-hartmann-626385254-38778510-1280.webp 1280w, /media/img/pexels-joerg-hartmann-626385254-38778510-1920.webp 1920w"
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="Mariposa posada sobre el follaje tropical"
          width="1920"
          height="1280"
          loading="lazy"
        />
        <figcaption class="experiencia-full__caption">
          Imagen ilustrativa: mariposa entre el follaje tropical.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ======== CONSERVACIÓN: contemplative, large image ------------------- -->
<section class="conservacion-essay reveal" aria-labelledby="cons-title">
  <div class="container">
    <div class="conservacion-essay__layout">
      <div class="conservacion-essay__image reveal-image">
        <img
          src="/media/img/mariposa-sobre-flor-amarilla-1280.jpg"
          srcset="/media/img/mariposa-sobre-flor-amarilla-640.webp 640w, /media/img/mariposa-sobre-flor-amarilla-1280.webp 1280w"
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="Mariposa posada sobre una flor amarilla"
          width="1280"
          height="960"
          loading="lazy"
        />
      </div>
      <div class="conservacion-essay__text">
        <h2 id="cons-title" class="conservacion-essay__title">¿Por qué son importantes las mariposas?</h2>
        <div class="prose">
          <p>
            Durante la visita también podrás conocer la relación de las
            mariposas con las plantas y la importancia que tienen dentro del
            ecosistema.
          </p>
        </div>
        <p class="section-actions">
          <a class="btn btn--ghost" href="/conservacion">Saber más</a>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======== GALERÍA: masonry editorial, preview reducida --------------- -->
<section class="galeria-editorial reveal" data-motion-group="galeria" aria-labelledby="gal-title">
  <div class="galeria-editorial__header" data-motion-item="copy">
    <h2 id="gal-title" class="galeria-editorial__title">Galería</h2>
    <p class="galeria-editorial__subtitle">
      Una mirada al mariposario, sus visitantes y el mundo de las mariposas.
    </p>
  </div>
  <div class="galeria-masonry" data-motion-item="stagger">
    <div class="galeria-masonry__item">
      <img src="/media/img/mariposa-azul-hoja-tropical-1280.jpg" srcset="/media/img/mariposa-azul-hoja-tropical-640.webp 640w, /media/img/mariposa-azul-hoja-tropical-1280.webp 1280w" sizes="(max-width: 768px) 100vw, 42vw" width="1280" height="720" alt="Mariposa azul sobre hoja tropical" loading="lazy" />
    </div>
    <div class="galeria-masonry__item">
      <img src="/media/img/grupo-mariposas-naranjas-en-planta-1280.jpg" srcset="/media/img/grupo-mariposas-naranjas-en-planta-640.webp 640w, /media/img/grupo-mariposas-naranjas-en-planta-1280.webp 1280w" sizes="(max-width: 768px) 50vw, 25vw" width="1280" height="1920" alt="Grupo de mariposas naranjas sobre una planta" loading="lazy" />
    </div>
    <div class="galeria-masonry__item">
      <img src="/media/img/mariposas-naranjas-en-vuelo-1280.jpg" srcset="/media/img/mariposas-naranjas-en-vuelo-640.webp 640w, /media/img/mariposas-naranjas-en-vuelo-1280.webp 1280w, /media/img/mariposas-naranjas-en-vuelo-1920.webp 1920w" sizes="(max-width: 768px) 50vw, 58vw" width="1280" height="856" alt="Mariposas naranjas en vuelo" loading="lazy" />
    </div>
    <div class="galeria-masonry__item">
      <img src="/media/img/mariposas-naranjas-fondo-natural-1280.jpg" srcset="/media/img/mariposas-naranjas-fondo-natural-640.webp 640w, /media/img/mariposas-naranjas-fondo-natural-1280.webp 1280w" sizes="(max-width: 768px) 50vw, 58vw" width="1280" height="1920" alt="Mariposas naranjas sobre fondo natural oscuro" loading="lazy" />
    </div>
    <div class="galeria-masonry__item">
      <img src="/media/img/mariposa-oscura-puntos-azules-960.jpg" srcset="/media/img/mariposa-oscura-puntos-azules-640.webp 640w, /media/img/mariposa-oscura-puntos-azules-960.webp 960w" sizes="(max-width: 768px) 50vw, 42vw" width="960" height="540" alt="Mariposa oscura con puntos azules" loading="lazy" />
    </div>
    <div class="galeria-masonry__item">
      <img src="/media/img/mariposario-bajo-la-paz-02-1280.jpg" srcset="/media/img/mariposario-bajo-la-paz-02-640.webp 640w, /media/img/mariposario-bajo-la-paz-02-1280.webp 1280w, /media/img/mariposario-bajo-la-paz-02-1920.webp 1920w" sizes="(max-width: 768px) 50vw, 58vw" width="1280" height="960" alt="Entorno del Jardín de Mariposas La Paz" loading="lazy" />
    </div>
  </div>
  <div class="galeria-editorial__cta">
    <a class="btn btn--ghost" href="/galeria">Ver galería completa</a>
  </div>
</section>

<!-- ======== PLANIFICA TU VISITA: datos prácticos, sin mapa ------------- -->
<section class="planifica reveal" aria-labelledby="plan-title">
  <div class="container">
    <div class="planifica__layout">
      <div class="planifica__text">
        <p class="planifica__label">Planifica tu visita</p>
        <h2 id="plan-title" class="planifica__title">Datos prácticos</h2>
        <dl class="ubicacion-details">
          <div>
            <dt>Ubicación</dt>
            <dd><%= site.location.address.split(', ').slice(0, 2).join(' · ') %></dd>
          </div>
          <div>
            <dt>Horario</dt>
            <dd>
              <% site.hours.forEach(function (slot, i) { %><%= slot.days %>: <%= slot.time %><%= i < site.hours.length - 1 ? ' · ' : '' %><% }) %>
            </dd>
          </div>
          <div>
            <dt>Tour guiado</dt>
            <dd>Precio y duración: consultar por WhatsApp.</dd>
          </div>
        </dl>
      </div>
      <div class="planifica__cta">
        <p class="planifica__cta-body">
          ¿Quieres planear una visita? Escríbenos y te contamos los detalles.
        </p>
        <p class="section-actions">
          <a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
            Consultar por WhatsApp
          </a>
          <a class="btn btn--ghost" href="/visitanos">Cómo llegar</a>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======== CTA FINAL: ¿Planeas una visita? ---------------------------- -->
<section class="cta-final reveal" data-motion-group="cta" aria-labelledby="cta-final-title">
  <div class="container--narrow" data-motion-item="copy">
    <p class="eyebrow eyebrow--on-dark">¿Planeas una visita?</p>
    <h2 id="cta-final-title" class="cta-final__title">Conversemos sobre tu visita</h2>
    <p class="cta-final__body">
      Para visitas individuales, familiares, grupales o educativas, consulta
      disponibilidad, precio y duración por WhatsApp.
    </p>
    <a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
      Consultar por WhatsApp
    </a>
  </div>
</section>
