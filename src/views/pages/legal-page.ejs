<% const c = content; %>
<section class="page-header legal-page__header"><div class="container--narrow"><p class="page-header__label"><%= c.header.eyebrow %></p><h1 class="page-header__title"><%= c.header.title %></h1><p class="page-header__lead"><%= c.header.lead %></p></div></section>
<section class="legal-page"><div class="container--narrow"><% if (c.intro) { %><div class="prose legal-page__intro"><p><%= c.intro %></p></div><% } %><% c.sections.forEach(function (section) { %><section class="legal-page__section" aria-labelledby="legal-<%= section.id %>"><h2 id="legal-<%= section.id %>"><%= section.heading %></h2><div class="prose"><% section.paragraphs.forEach(function (paragraph) { %><p><%= paragraph %></p><% }) %><% if (section.items && section.items.length) { %><ul><% section.items.forEach(function (item) { %><li><%= item %></li><% }) %></ul><% } %><% if (section.links && section.links.length) { %><ul><% section.links.forEach(function (link) { %><li><a href="<%= link.href %>" target="_blank" rel="noopener"><%= link.label %></a><% if (link.licenseHref) { %> — <a href="<%= link.licenseHref %>" target="_blank" rel="license noopener"><%= link.licenseLabel %></a><% } %></li><% }) %></ul><% } %></div></section><% }) %><aside class="legal-page__contact" aria-labelledby="legal-contact"><h2 id="legal-contact"><%= c.contact.heading %></h2><p><strong><%= c.contact.responsiblesLabel %></strong></p><ul><% site.contact.siteResponsibles.forEach(function (responsible) { %><li><%= responsible %></li><% }) %></ul><p><a href="mailto:<%= site.contact.email %>"><%= site.contact.email %></a></p><p><a href="<%= whatsapp.primaryHref %>"><%= site.phones.primary %></a><br /><a href="<%= whatsapp.secondaryHref %>"><%= site.phones.secondary %></a></p><address><%= site.location.address %></address></aside><p class="legal-page__updated"><%= c.updated %></p></div></section>
