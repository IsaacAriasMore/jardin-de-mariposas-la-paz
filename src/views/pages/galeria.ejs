<!-- ======== OUTRO: hacia la visita -------------------------------------- -->
<section class="page-section page-section--dark reveal">
  <div class="container--narrow">
    <p class="eyebrow eyebrow--on-dark">Ver en persona</p>
    <h2>Las imágenes cuentan solo una parte</h2>
    <div class="prose">
      <p>
        El mariposario se vive recorriéndolo. Consulte horarios, entrada y cómo
        llegar, y visite el mariposario en Bajo La Paz, San Ramón.
      </p>
    </div>
    <p class="section-actions">
      <a class="btn btn--ghost-dark" href="/visitanos">Visítanos</a>
      <a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
        WhatsApp
      </a>
    </p>
  </div>
</section>
