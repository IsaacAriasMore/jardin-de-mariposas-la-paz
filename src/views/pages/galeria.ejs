<% const c = content; const images = [['mariposario-bajo-la-paz-01-1280.jpg',1280,1707],['mariposas-naranjas-en-vuelo-1280.jpg',1280,856],['visitantes-dentro-mariposario-960.jpg',960,640],['grupo-mariposas-naranjas-en-planta-1280.jpg',1280,1920],['guia-acompanando-visitante-960.jpg',960,640],['mariposa-oscura-puntos-azules-960.jpg',960,540],['mariposario-bajo-la-paz-02-1280.jpg',1280,960],['mariposa-negra-amarilla-flor-roja-1280.jpg',1280,1800],['mariposa-azul-hoja-tropical-1280.jpg',1280,720],['mariposas-naranjas-fondo-natural-1280.jpg',1280,1920]]; %>
<section class="page-header"><div class="container"><p class="page-header__label"><%= c.header.eyebrow %></p><h1 class="page-header__title"><%= c.header.title %></h1><p class="page-header__lead"><%= c.header.lead %></p></div></section>
<section class="galeria-full reveal" data-motion-group="galeria-principal"><%- include('../partials/section-butterflies', { butterflies: ['gallery-main'] }) %><div class="container"><div class="galeria-full__masonry" data-motion-item="gallery-stagger"><% images.forEach(function(image,index){ const base=image[0].replace(/-\d+\.jpg$/, ''); %><figure class="galeria-full__item"><img src="/media/img/<%= image[0] %>" srcset="/media/img/<%= base %>-640.jpg 640w, /media/img/<%= image[0] %> <%= image[1] %>w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw" alt="<%= c.items.alts[index] %>" width="<%= image[1] %>" height="<%= image[2] %>" loading="lazy" decoding="async" /></figure><% }) %></div><p class="media-note"><%= c.items.note %></p></div></section>
<section class="page-section page-section--dark reveal" data-motion-group="galeria-cta"><%- include('../partials/section-butterflies', { butterflies: ['gallery-cta'] }) %><div class="container--narrow" data-motion-item="copy"><p class="eyebrow eyebrow--on-dark"><%= c.cta.eyebrow %></p><h2><%= c.cta.title %></h2><div class="prose"><p><%= c.cta.body %></p></div><p class="section-actions"><a class="btn btn--ghost-dark" href="<%= paths.visit %>"><%= t('nav.visit') %></a><a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">WhatsApp</a></p></div></section>
