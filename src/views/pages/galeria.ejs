          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
          alt="El Jardín de Mariposas La Paz en Bajo La Paz, San Ramón"
          width="1280"
          height="1707"
          loading="lazy"
        />
        <figcaption class="media-caption">El mariposario en Bajo La Paz, San Ramón</figcaption>
      </figure>
      <figure class="galeria-full__item">
        <img
          src="/media/img/mariposas-naranjas-en-vuelo-1280.jpg"
