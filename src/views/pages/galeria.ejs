<!-- Galería: masonry editorial con el material aprobado en MEDIA-CATALOG.md.
     REAL: mariposario-bajo-la-paz-01 / -02 (fotografías del mariposario en Bajo
     La Paz, San Ramón). STOCK: el resto, como apoyo ilustrativo de mariposas
     y flores tropicales (no se afirma que correspondan al mariposario). -->
<section class="page-header">
  <div class="container">
    <p class="page-header__label">Fotografía</p>
    <h1 class="page-header__title">Galería</h1>
    <p class="page-header__lead">
      Color, detalle y movimiento: mariposas y flores tropicales, junto con
      algunas fotografías del mariposario en Bajo La Paz, San Ramón.
    </p>
  </div>
</section>

<section class="galeria-full reveal">
