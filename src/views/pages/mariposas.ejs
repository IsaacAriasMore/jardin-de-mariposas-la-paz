<% const c = content; %>
<section class="page-header"><div class="container"><p class="page-header__label"><%= c.header.eyebrow %></p><h1 class="page-header__title"><%= c.header.title %></h1><p class="page-header__lead"><%= c.header.lead %></p></div></section>
<section class="mariposas-apertura reveal" data-motion-group="transformacion"><%- include('../partials/section-butterflies', { butterflies: ['butterflies-opening'] }) %><div class="container"><div class="mariposas-apertura__layout"><div class="mariposas-apertura__text" data-motion-item="copy-start"><p class="eyebrow"><%= c.opening.eyebrow %></p><h2><%= c.opening.title %></h2><p class="mariposas-apertura__body"><%= c.opening.body1 %></p><p class="mariposas-apertura__body"><%= c.opening.body2 %></p></div><figure class="mariposas-apertura__media" data-motion-item="media-end"><img src="/media/img/mariposa-negra-amarilla-flor-roja-1280.jpg" alt="<%= c.opening.alt %>" width="1280" height="1800" loading="lazy" /></figure></div></div></section>
<section class="mariposas-banda reveal" data-motion-group="banda-mariposa"><%- include('../partials/section-butterflies', { butterflies: ['butterflies-band'] }) %><div class="container"><div class="mariposas-banda__layout"><figure class="mariposas-banda__media" data-motion-item="media-start"><img src="/media/img/mariposa-azul-hoja-tropical-1920.jpg" alt="<%= c.band.alt %>" width="1920" height="1080" loading="lazy" /></figure><div class="mariposas-banda__copy" data-motion-item="copy-end"><h2><%= c.band.title %></h2><p><%= c.band.body %></p></div></div></div></section>
<section class="mariposas-galeria page-section reveal" data-motion-group="diversidad-galeria"><%- include('../partials/section-butterflies', { butterflies: ['butterflies-gallery'] }) %><div class="container"><div class="mariposas-galeria__header" data-motion-item="copy"><h2><%= c.gallery.title %></h2><p class="mariposas-galeria__subtitle"><%= c.gallery.subtitle %></p></div><div class="mariposas-galeria__grid" data-motion-item="gallery-stagger"><% const images=[['grupo-mariposas-naranjas-en-planta-1280.jpg',1280,1920],['mariposa-oscura-puntos-azules-960.jpg',960,540],['mariposas-naranjas-fondo-natural-1280.jpg',1280,1920],['mariposas-naranjas-en-vuelo-1280.jpg',1280,856]]; images.forEach(function(image,index){ const base=image[0].replace(/-\d+\.jpg$/, ''); %><figure class="mariposas-galeria__item"><img src="/media/img/<%= image[0] %>" srcset="/media/img/<%= base %>-640.jpg 640w, /media/img/<%= image[0] %> <%= image[1] %>w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 25vw" alt="<%= c.gallery.alts[index] %>" width="<%= image[1] %>" height="<%= image[2] %>" loading="lazy" decoding="async" /></figure><% }) %></div></div></section>
<section class="mariposas-outro page-section reveal" data-motion-group="observar-cta"><%- include('../partials/section-butterflies', { butterflies: ['butterflies-outro'] }) %><div class="container"><div class="mariposas-outro__layout"><figure class="mariposas-outro__image" data-motion-item="media-start"><img src="/media/img/mariposa-cola-larga-volando-flores-1280.jpg" alt="<%= c.outro.alt %>" width="1280" height="853" loading="lazy" /></figure><div class="mariposas-outro__text" data-motion-item="copy-end"><p class="eyebrow"><%= c.outro.eyebrow %></p><h2><%= c.outro.title %></h2><div class="prose"><p><%= c.outro.body %></p></div><p class="section-actions"><a class="btn" href="<%= paths.experience %>"><%= t('actions.tour') %></a><a class="btn btn--ghost" href="<%= paths.visit %>"><%= t('nav.visit') %></a></p></div></div></div></section>
