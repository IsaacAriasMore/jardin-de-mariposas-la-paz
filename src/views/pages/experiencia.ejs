<% const c = content; %>
<section class="page-header page-header--dark"><div class="container"><p class="page-header__label"><%= c.header.eyebrow %></p><h1 class="page-header__title"><%= c.header.title %></h1><p class="page-header__lead"><%= t('pages:experience.header.lead', { siteName: site.name }) %></p></div></section>
<section class="exp-guiada reveal" data-motion-group="tour-detalles"><%- include('../partials/section-butterflies', { butterflies: ['experience-tour'] }) %><div class="container"><div class="exp-guiada__grid"><div class="exp-guiada__intro" data-motion-item="copy"><p class="eyebrow"><%= c.tour.eyebrow %></p><h2><%= c.tour.title %></h2><div class="prose"><p><%= c.tour.body %></p></div><p class="guide-credential"><span class="guide-credential__title"><%= t('business.guideCredential') %></span><span class="guide-credential__sub"><%= t('business.serviceLanguages') %></span></p></div><div class="exp-guiada__publics" data-motion-item="stagger"><div class="exp-guiada__group"><h3><%= c.tour.educationTitle %></h3><p class="exp-guiada__group-text"><%= c.tour.education %></p></div><div class="exp-guiada__group"><h3><%= c.tour.companionshipTitle %></h3><p class="exp-guiada__group-text"><%= c.tour.companionship %></p></div></div></div><div class="exp-guiada__cta" data-motion-item="actions"><a class="btn btn--whatsapp btn--large" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultVisit') %></a><p class="exp-guiada__note"><%= c.tour.note %></p></div></div></section>
<section class="experiencia-aprende page-section--muted reveal" data-motion-group="ciclo-vida"><%- include('../partials/section-butterflies', { butterflies: ['experience-life'] }) %><div class="container"><div class="experiencia-aprende__layout"><div class="experiencia-aprende__text" data-motion-item="copy"><p class="eyebrow"><%= c.life.eyebrow %></p><h2><%= c.life.title %></h2><div class="prose"><p><%= c.life.body1 %></p><p><%= c.life.body2 %></p></div></div><div class="experiencia-aprende__etapas" data-motion-item="stagger"><% c.life.stages.forEach(function (stage) { %><span class="experiencia-aprende__chip"><%= stage %></span><% }) %></div></div></div></section>
<section class="experiencia-immersive page-section--dark reveal" data-motion-group="experiencia-inmersiva"><div class="container"><div class="experiencia-immersive__hero" data-motion-item="clip"><video autoplay muted loop playsinline preload="none" poster="/media/posters/mariposa-flores-tropicales-detalle.jpg" aria-hidden="true" data-motion-video data-video-src="/media/videos/mariposa-flores-tropicales-1080p.mp4"></video></div><div class="experiencia-immersive__content"><div class="experiencia-immersive__text" data-motion-item="copy"><p class="eyebrow eyebrow--on-dark"><%= c.immersive.eyebrow %></p><h2><%= c.immersive.title %></h2><div class="prose"><p><%= c.immersive.body %></p></div></div><div class="experiencia-immersive__gallery" data-motion-item="gallery-stagger"><% const images = ['guia-grupo-adultos-960.jpg','visitantes-dentro-mariposario-960.jpg']; images.forEach(function(image, index) { %><figure class="experiencia-immersive__gallery-item"><img src="/media/img/<%= image %>" alt="<%= c.immersive.alts[index] %>" width="960" height="640" loading="lazy" /></figure><% }) %></div></div></div></section>
<section class="experiencia-pausa reveal" data-motion-group="pausa-editorial"><%- include('../partials/section-butterflies', { butterflies: ['experience-pause'] }) %><div class="container"><figure class="experiencia-pausa__media" data-motion-item="media"><img src="/media/img/mariposario-bajo-la-paz-02-1920.jpg" alt="<%= c.pause.alt %>" width="1920" height="1440" loading="lazy" /></figure></div></section>
<section class="experiencia-cta reveal" data-motion-group="cta-experiencia"><%- include('../partials/section-butterflies', { butterflies: ['experience-cta'] }) %><div class="container" data-motion-item="copy"><p class="eyebrow eyebrow--on-dark"><%= c.cta.eyebrow %></p><h2><%= c.cta.title %></h2><p class="experiencia-cta__body"><%= c.cta.body %></p><p class="section-actions"><a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener"><%= t('actions.consultVisit') %></a><a class="btn btn--ghost-dark" href="<%= paths.visit %>"><%= t('nav.visit') %></a></p></div></section>
