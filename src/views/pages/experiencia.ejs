<!-- Experiencia: composición cinematográfica e inmersiva, abre en oscuro.
     VIDEO: el protagonista es mariposa-flores-tropicales (solo existe MP4;
     si en el futuro se genera un WebM se agrega como primer <source> antes
     del fallback MP4). El video y las fotos de apoyo son material STOCK
     usado como recurso visual: no se afirma que correspondan al jardín.
     No se inventan servicios, tours, duración, testimonios ni actividades. -->

<section class="page-header page-header--dark">
  <div class="container">
    <p class="page-header__label">La experiencia</p>
    <h1 class="page-header__title">La Experiencia</h1>
    <p class="page-header__lead">
      Mariposas de cerca, flores tropicales y la calma de un jardín en el
      bosque nuboso de San Ramón.
    </p>
  </div>
</section>

<!-- ======== INMERSIVO: video protagonista + texto breve ---------------- -->
<section class="experiencia-immersive page-section--dark reveal">
  <div class="container">
    <div class="experiencia-immersive__hero reveal-clip">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/media/posters/mariposa-flores-tropicales-detalle.jpg"
        aria-hidden="true"
      >
        <!-- WebM cuando exista: <source src="...webm" type="video/webm" /> -->
        <source src="/media/videos/mariposa-flores-tropicales-1080p.mp4" type="video/mp4" />
      </video>
    </div>
    <p class="experiencia-immersive__hero-caption">
      Video ilustrativo: mariposas entre flores tropicales.
    </p>

    <div class="experiencia-immersive__content">
      <div class="experiencia-immersive__text">
        <p class="eyebrow eyebrow--on-dark">Cercanía</p>
        <h2>Observar de cerca, sin prisa</h2>
        <div class="prose">
          <p>
            La experiencia es sencilla: recorrer el jardín a su propio ritmo,
            detenerse junto a las flores y esperar a que las mariposas lleguen.
          </p>
          <p>
            Sin guiones ni tiempos marcados. Solo el entorno natural del
            mariposario en Bajo La Paz, San Ramón.
          </p>
        </div>
      </div>
      <div class="experiencia-immersive__gallery reveal-stagger">
        <figure class="experiencia-immersive__gallery-item">
          <img
            src="/media/img/pexels-joerg-hartmann-626385254-38778510-1920.jpg"
            srcset="/media/img/pexels-joerg-hartmann-626385254-38778510-640.webp 640w, /media/img/pexels-joerg-hartmann-626385254-38778510-1280.webp 1280w, /media/img/pexels-joerg-hartmann-626385254-38778510-1920.webp 1920w"
            sizes="(max-width: 768px) 50vw, 25vw"
            alt="Mariposa posada sobre el follaje"
            width="1920"
            height="1280"
            loading="lazy"
          />
        </figure>
        <figure class="experiencia-immersive__gallery-item">
          <img
            src="/media/img/pexels-abdullah-elgumus-917947069-38000621-1920.jpg"
            srcset="/media/img/pexels-abdullah-elgumus-917947069-38000621-640.webp 640w, /media/img/pexels-abdullah-elgumus-917947069-38000621-1280.webp 1280w, /media/img/pexels-abdullah-elgumus-917947069-38000621-1920.webp 1920w"
            sizes="(max-width: 768px) 50vw, 25vw"
            alt="Mariposa posada sobre una flor"
            width="1920"
            height="1280"
            loading="lazy"
          />
        </figure>
        <figure class="experiencia-immersive__gallery-item">
          <img
            src="/media/img/mariposa-sobre-flor-amarilla-1280.jpg"
            srcset="/media/img/mariposa-sobre-flor-amarilla-640.webp 640w, /media/img/mariposa-sobre-flor-amarilla-1280.webp 1280w"
            sizes="(max-width: 768px) 50vw, 25vw"
            alt="Mariposa posada sobre una flor amarilla"
            width="1280"
            height="960"
            loading="lazy"
          />
        </figure>
        <p class="experiencia-immersive__gallery-note">
          Imágenes ilustrativas de mariposas y flores tropicales.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ======== PAUSA: banda contemplativa en claro ------------------------ -->
<section class="experiencia-pausa reveal">
  <div class="container">
    <figure class="experiencia-pausa__media reveal-image">
      <img
        src="/media/img/mariposario-bajo-la-paz-02-1920.jpg"
        srcset="/media/img/mariposario-bajo-la-paz-02-640.webp 640w, /media/img/mariposario-bajo-la-paz-02-1280.webp 1280w, /media/img/mariposario-bajo-la-paz-02-1920.webp 1920w"
        sizes="100vw"
        alt="El Jardín de Mariposas La Paz en Bajo La Paz, San Ramón"
        width="1920"
        height="1440"
        loading="lazy"
      />
      <figcaption>El jardín en Bajo La Paz, San Ramón</figcaption>
    </figure>
  </div>
</section>

<!-- ======== CTA: hacia Visítanos / WhatsApp ---------------------------- -->
<section class="experiencia-cta reveal">
  <div class="container">
    <h2>¿Listo para conocerlo en persona?</h2>
    <p class="experiencia-cta__body">
      Consulte horarios, entrada y cómo llegar. Estamos en Bajo La Paz, San
      Ramón, entre el bosque nuboso y el paisaje rural de Alajuela.
    </p>
    <p class="section-actions">
      <a class="btn btn--ghost-dark" href="/visitanos">Visítanos</a>
      <a class="btn btn--whatsapp" href="<%= whatsapp.primary %>" target="_blank" rel="noopener">
        WhatsApp
      </a>
    </p>
  </div>
</section>
