<!DOCTYPE html>
<html lang="<%= locale === 'en' ? 'en' : 'es-CR' %>" data-theme="light">
  <%- include('partials/head') %>
  <body class="<%= pageKey === 'home' && (currentPath === paths.home || currentPath === paths.homeEn) ? 'has-hero' : '' %>">
    <span id="topo" hidden></span>
    <a class="skip-link" href="#contenido"><%= t('actions.skip') %></a>
    <%- include('partials/navbar') %>
    <main id="contenido"><%- body %></main>
    <%- include('partials/footer') %>
  </body>
</html>
